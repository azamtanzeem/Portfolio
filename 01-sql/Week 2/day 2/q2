Odd and Even Measurements (Google) - DataLemur

with measurement_count AS (
select 
CAST(measurement_time as date) as measurement_day,
measurement_value,
row_number() over (partition by cast(measurement_time as date)
order by measurement_time) as measurement_num
from measurements
)
select measurement_day,
sum(case when measurement_num%2 != 0 then measurement_value else 0 end) as odd_num_sum,
sum(case when measurement_num%2 = 0 then measurement_value else 0 end) as even_num_sum
from measurement_count 
group by measurement_day
